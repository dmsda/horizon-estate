# ==============================================================================
# Horizon Estate — Environment Configuration Template
# ==============================================================================
# All variables in this template are optional for basic local preview.
# Horizon Estate runs out-of-the-box with mock/sample data without external APIs.
# ==============================================================================

# Public Canonical Site URL (Used for OpenGraph, Twitter Cards, and Sitemap generation)
NEXT_PUBLIC_SITE_URL=https://horizonestate.com

# Map & Geolocation Integration (Optional: Mapbox GL / Google Maps)
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJ5b3VyLXRva2VuIn0

# Headless CMS Endpoint (Optional: Sanity / Strapi / Contentful)
# NEXT_PUBLIC_CMS_API_URL=https://your-cms-instance.com/api

# Contact & Consultation Form Webhook (Optional: Resend / SendGrid / Formspree)
# CONTACT_FORM_WEBHOOK_URL=https://api.resend.com/emails
# RESEND_API_KEY=re_123456789

# Analytics & Performance Monitoring (Optional: Plausible / Google Analytics)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
